{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:osdesign:config:1.0",
  "title": "CPU experiment configuration",
  "type": "object",
  "required": ["command", "workload_version", "input_id"],
  "additionalProperties": false,
  "properties": {
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "^[^\u0000]+$"}},
    "workload_version": {"type": "string", "minLength": 1},
    "input_id": {"type": "string", "minLength": 1},
    "cwd": {"type": "string", "minLength": 1, "pattern": "^[^\u0000]+$"},
    "quotas": {"type": "array", "minItems": 1, "items": {"anyOf": [{"type": "null"}, {"type": "number", "minimum": 1, "maximum": 10000}]}},
    "repeats": {"type": "integer", "minimum": 1, "maximum": 100},
    "warmups": {"type": "integer", "minimum": 0, "maximum": 20},
    "order_seed": {"type": "integer"},
    "timeout_seconds": {"type": "number", "minimum": 0.1, "maximum": 3600}
  }
}
