{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:osdesign:run:1.1",
  "title": "Finalized CPU experiment run 1.1",
  "type": "object",
  "required": ["schema_version", "run_id", "source", "timestamp_utc", "order_index", "warmup", "environment", "command", "cwd", "workload_version", "input_id", "quota_percent", "timeout_seconds", "unit", "status", "error", "exit_code", "wall_seconds", "cpu_seconds", "cpu_stat_delta", "cleanup_ok", "cleanup_detail", "runner_sha256", "git_commit", "git_dirty", "artifacts"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "1.1"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "source": {"enum": ["measured", "synthetic"]},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "order_index": {"type": "integer", "minimum": 0},
    "warmup": {"type": "boolean"},
    "environment": {"type": "object", "required": ["fingerprint"], "properties": {"fingerprint": {"$ref": "#/$defs/sha256"}}},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "cwd": {"type": "string", "minLength": 1},
    "workload_version": {"type": "string", "minLength": 1},
    "input_id": {"type": "string", "minLength": 1},
    "quota_percent": {"anyOf": [{"type": "null"}, {"type": "number", "minimum": 1, "maximum": 10000}]},
    "timeout_seconds": {"type": "number", "minimum": 0.1, "maximum": 3600},
    "unit": {"type": "string", "pattern": "^osdesign-[0-9a-f]{32}\\.service$"},
    "status": {"enum": ["success", "failed", "timeout", "error", "metrics_missing", "cleanup_failed", "interrupted", "aborted"]},
    "error": {"type": ["string", "null"]},
    "exit_code": {"type": ["integer", "null"]},
    "wall_seconds": {"type": ["number", "null"], "minimum": 0},
    "cpu_seconds": {"type": ["number", "null"], "minimum": 0},
    "cpu_stat_delta": {"type": ["object", "null"], "additionalProperties": {"type": "integer"}},
    "cleanup_ok": {"type": "boolean"},
    "cleanup_detail": {"type": ["object", "string"]},
    "runner_sha256": {"$ref": "#/$defs/sha256"},
    "stdout_sha256": {"$ref": "#/$defs/sha256"},
    "git_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "git_dirty": {"type": ["string", "null"]},
    "artifacts": {"type": "object", "required": ["stdout", "stderr"], "additionalProperties": {"type": "string"}},
    "interrupt_signal": {"enum": [2, 15]},
    "recovered": {"type": "boolean"},
    "visible_limits": {"type": "array", "items": {"type": "object", "required": ["path", "cpu_max", "cpuset_effective"]}},
    "quota_verified": {"type": "boolean"}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "success"}}}, "then": {
    "required": ["quota_verified", "stdout_sha256", "visible_limits"],
    "properties": {"exit_code": {"const": 0}, "error": {"type": "null"}, "cleanup_ok": {"const": true}, "quota_verified": {"const": true}, "wall_seconds": {"type": "number", "minimum": 0}, "cpu_seconds": {"type": "number", "minimum": 0}, "cpu_stat_delta": {"type": "object", "required": ["usage_usec"]}}
  }}],
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
